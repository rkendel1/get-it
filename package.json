{
  "name": "get-it",
  "version": "0.1.0",
  "private": true,
  "description": "Outcome-driven service business on FeltKit. First outcome: bill review and payable preparation over customer-supplied, Ledger-compatible bill sets; no accounting writes.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "feltkit codegen && tsc --noEmit && feltkit test",
    "typecheck": "feltkit codegen && tsc --noEmit",
    "codegen": "feltkit codegen",
    "contract:digest": "tsx scripts/contract-digest.ts",
    "test:only": "feltkit test",
    "sabotage": "node scripts/sabotage.mjs",
    "test:http": "feltkit test tests/http-transaction.test.ts",
    "test:browser": "feltkit test tests/browser.test.ts tests/browser-boundaries.test.ts tests/browser-tasks.test.ts",
    "dev": "feltkit dev",
    "build": "feltkit build"
  },
  "dependencies": {
    "@feltdb/feltkit": "0.3.27",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "playwright": "1.63.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
